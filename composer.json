{
    "name": "bookmusic/mall",
    "description": "小说与音乐数字内容销售平台",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "vlucas/phpdotenv": "^5.5",
        "resend/resend-php": "*",
        "sentry/sentry": "^4.27",
        "wechatpay/wechatpay": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Core\\": "core/"
        },
        "files": [
            "includes/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    }
}
