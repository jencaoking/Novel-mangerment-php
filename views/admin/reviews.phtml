<script>
function toggleReviewStatus(id) {
    if (!confirm('确定要更改此评价的显示状态吗？')) {
        return;
    }

    fetch(`/admin/reviews/toggle/${id}`, {
        method: 'POST',
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            // 刷新当前页面以更新状态
            window.location.reload();
        } else {
            alert(data.message || '操作失败');
        }
    })
    .catch(err => {
        console.error('Error:', err);
        alert('网络错误，请稍后再试');
    });
}
</script>

