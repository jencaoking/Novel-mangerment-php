<script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.3/build/qrcode.min.js"></script>
<script>
let cartPayTimer = null;
let currentBatchTradeNo = null;

document.addEventListener('DOMContentLoaded', function() {
    initCartFunctions();
});

function initCartFunctions() {
    const selectAllTop = document.getElementById('selectAll');
    const selectAllBottom = document.getElementById('selectAllBottom');

    if (selectAllTop) selectAllTop.addEventListener('change', toggleSelectAll);
    if (selectAllBottom) selectAllBottom.addEventListener('change', toggleSelectAll);

    document.querySelectorAll('.product-checkbox').forEach(cb => {
        cb.addEventListener('change', updateSummary);
    });

    const alipayModal = document.getElementById('alipayModal');
    if (alipayModal) {
        alipayModal.addEventListener('click', function(e) {
            if (e.target === this) {
                closeAlipayModal();
            }
        });
    }

    const wechatPayModal = document.getElementById('wechatPayModal');
    if (wechatPayModal) {
        wechatPayModal.addEventListener('click', function(e) {
            if (e.target === this) {
                closeWechatPayModal();
            }
        });
    }

    // 支付渠道切换时更新按钮文字
    document.querySelectorAll('input[name="payment_channel"]').forEach(radio => {
        radio.addEventListener('change', function() {
            const checkoutBtn = document.querySelector('.cart-footer-right .btn-primary');
            if (this.value === 'wechat') {
                checkoutBtn.innerHTML = '<i class="bi bi-wechat"></i> 微信支付';
            } else {
                checkoutBtn.innerHTML = '<i class="bi bi-credit-card"></i> 合并结算';
            }
        });
    });
}

function toggleSelectAll() {
    const selectAllTop = document.getElementById('selectAll');
    const selectAllBottom = document.getElementById('selectAllBottom');
    const checkboxes = document.querySelectorAll('.product-checkbox');
    
    const isChecked = selectAllTop.checked || selectAllBottom.checked;
    
    selectAllTop.checked = isChecked;
    selectAllBottom.checked = isChecked;
    
    checkboxes.forEach(cb => cb.checked = isChecked);
    
    updateSummary();
}

function updateSummary() {
    const checkboxes = document.querySelectorAll('.product-checkbox:checked');
    const items = document.querySelectorAll('.cart-item-card');
    
    let selectedCount = 0;
    let totalPrice = 0;
    
    checkboxes.forEach(cb => {
        const productId = cb.value;
        const item = document.querySelector(`.cart-item-card[data-product-id="${productId}"]`);
        if (item) {
            const priceElement = item.querySelector('.price-value');
            const priceText = priceElement.textContent.replace('¥', '').replace(',', '');
            totalPrice += parseFloat(priceText);
            selectedCount++;
        }
    });
    
    document.getElementById('selectedCount').textContent = selectedCount;
    document.getElementById('totalAmount').textContent = '¥' + totalPrice.toFixed(2);
    
    const allCheckboxes = document.querySelectorAll('.product-checkbox');
    const selectAllTop = document.getElementById('selectAll');
    const selectAllBottom = document.getElementById('selectAllBottom');
    
    if (selectedCount === allCheckboxes.length && selectedCount > 0) {
        selectAllTop.checked = true;
        selectAllBottom.checked = true;
    } else {
        selectAllTop.checked = false;
        selectAllBottom.checked = false;
    }
}

async function removeItem(productId) {
    if (!confirm('确定要移除该商品吗？')) {
        return;
    }
    
    try {
        const response = await fetch('/api/cart/remove', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `product_id=${productId}`
        });
        const data = await response.json();
        
        if (data.success) {
            const item = document.querySelector(`.cart-item-card[data-product-id="${productId}"]`);
            if (item) {
                item.style.transition = 'all 0.3s ease-out';
                item.style.opacity = '0';
                item.style.transform = 'translateX(-100%)';
                
                setTimeout(() => {
                    item.remove();
                    if (document.querySelectorAll('.cart-item-card').length === 0) {
                        window.location.reload();
                    } else {
                        updateSummary();
                    }
                }, 300);
            }
            
            showNotification('已移除', 'success');
            updateCartCount(data.cart_count);
        } else {
            showNotification(data.message || '移除失败', 'error');
        }
    } catch (err) {
        console.error(err);
        showNotification('网络错误，请稍后再试', 'error');
    }
}

async function clearCart() {
    if (!confirm('确定要清空购物车吗？')) {
        return;
    }
    
    try {
        const response = await fetch('/api/cart/clear', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
        });
        const data = await response.json();
        
        if (data.success) {
            window.location.reload();
        } else {
            showNotification(data.message || '清空失败', 'error');
        }
    } catch (err) {
        console.error(err);
        showNotification('网络错误，请稍后再试', 'error');
    }
}

async function checkout() {
    const checkboxes = document.querySelectorAll('.product-checkbox:checked');

    if (checkboxes.length === 0) {
        showNotification('请至少选择一件商品', 'error');
        return;
    }

    const paymentChannel = document.querySelector('input[name="payment_channel"]:checked').value;

    try {
        const productIds = Array.from(checkboxes).map(cb => cb.value);
        const formData = new URLSearchParams();
        productIds.forEach(id => {
            formData.append('product_ids[]', id);
        });
        formData.append('payment_channel', paymentChannel);

        const response = await fetch('/api/checkout/cart', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: formData.toString()
        });

        const data = await response.json();

        if (data.success) {
            currentBatchTradeNo = data.batch_trade_no;

            if (data.channel === 'wechat') {
                // 微信支付
                showWechatPayModal(data.total_amount, data.code_url, data.batch_trade_no);
            } else {
                // 支付宝支付
                showAlipayModal(data.total_amount, data.pay_url);
                startPaymentPolling(currentBatchTradeNo);
            }
        } else {
            showNotification(data.message || '结算失败', 'error');
        }
    } catch (err) {
        console.error(err);
        showNotification('网络错误，请稍后再试', 'error');
    }
}

function showAlipayModal(amount, qrUrl) {
    const modal = document.getElementById('alipayModal');
    const qrcodeImg = document.getElementById('alipayQrcode');
    const qrcodeLoading = document.getElementById('qrcodeLoading');
    const payAmount = document.getElementById('payAmount');
    const payStatusText = document.getElementById('payStatusText');

    payAmount.textContent = parseFloat(amount).toFixed(2);
    payStatusText.innerHTML = '<div class="status-waiting"><i class="bi bi-hourglass-split"></i><span>等待扫码支付...</span></div>';

    qrcodeLoading.classList.remove('hidden');
    qrcodeImg.style.opacity = '0';

    modal.classList.add('visible');

    if (qrUrl) {
        qrcodeImg.onload = function() {
            qrcodeLoading.classList.add('hidden');
            qrcodeImg.style.opacity = '1';
        };
        qrcodeImg.onerror = function() {
            qrcodeLoading.innerHTML = '<p class="text-danger">二维码加载失败</p>';
        };
        qrcodeImg.src = qrUrl;
    }
}

function closeAlipayModal() {
    const modal = document.getElementById('alipayModal');
    modal.classList.remove('visible');
    stopPaymentPolling();
    currentBatchTradeNo = null;
}

function showWechatPayModal(amount, codeUrl, batchTradeNo) {
    const modal = document.getElementById('wechatPayModal');
    const qrcodeContainer = document.getElementById('wechatQrcode');
    const qrcodeLoading = document.getElementById('wechatQrcodeLoading');
    const payAmount = document.getElementById('wechatPayAmount');
    const payStatusText = document.getElementById('wechatPayStatusText');

    payAmount.textContent = parseFloat(amount).toFixed(2);
    payStatusText.innerHTML = '<div class="status-waiting"><i class="bi bi-hourglass-split"></i><span>等待扫码支付...</span></div>';

    qrcodeLoading.classList.remove('hidden');
    qrcodeContainer.innerHTML = '';

    modal.classList.add('visible');

    if (codeUrl) {
        // 使用 qrcode.js 生成二维码
        QRCode.toCanvas(codeUrl, {
            width: 200,
            margin: 2,
            color: {
                dark: '#000000',
                light: '#ffffff'
            }
        }, function(error, canvas) {
            qrcodeLoading.classList.add('hidden');
            if (error) {
                console.error(error);
                qrcodeContainer.innerHTML = '<p class="text-danger">二维码生成失败</p>';
                return;
            }
            canvas.style.width = '100%';
            canvas.style.height = '100%';
            qrcodeContainer.appendChild(canvas);

            // 启动轮询
            startWechatPaymentPolling(batchTradeNo);
        });
    }
}

function closeWechatPayModal() {
    const modal = document.getElementById('wechatPayModal');
    modal.classList.remove('visible');
    stopWechatPaymentPolling();
    currentBatchTradeNo = null;
}

function startWechatPaymentPolling(batchTradeNo) {
    stopWechatPaymentPolling();

    cartPayTimer = setInterval(async () => {
        try {
            const response = await fetch(`/api/order/status?batch_trade_no=${encodeURIComponent(batchTradeNo)}`);
            const data = await response.json();

            if (data.success) {
                const payStatusText = document.getElementById('wechatPayStatusText');

                if (data.status === 'paid') {
                    stopWechatPaymentPolling();
                    payStatusText.innerHTML = '<div class="status-success"><i class="bi bi-check-circle-fill"></i><span>支付成功！正在跳转...</span></div>';
                    setTimeout(() => {
                        window.location.href = '/user/downloads';
                    }, 1500);
                } else if (data.status === 'partial_paid') {
                    payStatusText.innerHTML = '<div class="status-waiting"><i class="bi bi-clock-history"></i><span>部分订单已支付，请稍候...</span></div>';
                }
            }
        } catch (err) {
            console.error('支付状态查询失败:', err);
        }
    }, 3000);
}

function stopWechatPaymentPolling() {
    if (cartPayTimer) {
        clearInterval(cartPayTimer);
        cartPayTimer = null;
    }
}

function startPaymentPolling(batchTradeNo) {
    stopPaymentPolling();
    
    cartPayTimer = setInterval(async () => {
        try {
            const response = await fetch(`/api/order/status?batch_trade_no=${encodeURIComponent(batchTradeNo)}`);
            const data = await response.json();
            
            if (data.success) {
                const payStatusText = document.getElementById('payStatusText');
                
                if (data.status === 'paid') {
                    stopPaymentPolling();
                    payStatusText.innerHTML = '<div class="status-success"><i class="bi bi-check-circle-fill"></i><span>支付成功！正在跳转...</span></div>';
                    setTimeout(() => {
                        window.location.href = '/user/downloads';
                    }, 1500);
                } else if (data.status === 'partial_paid') {
                    payStatusText.innerHTML = '<div class="status-waiting"><i class="bi bi-clock-history"></i><span>部分订单已支付，请稍候...</span></div>';
                }
            }
        } catch (err) {
            console.error('支付状态查询失败:', err);
        }
    }, 3000);
}

function stopPaymentPolling() {
    if (cartPayTimer) {
        clearInterval(cartPayTimer);
        cartPayTimer = null;
    }
}

window.addEventListener('beforeunload', function() {
    stopPaymentPolling();
});
</script>

