    <!-- 支付提示模态框 -->
    <div id="paymentModal" class="modal" style="display:none;">
        <div class="modal-content">
            <div class="modal-header">
                <h3>订单提交成功</h3>
                <button type="button" class="modal-close" onclick="closeModal()">&times;</button>
            </div>
            <div class="modal-body">
                <p>正在跳转到支付宝支付页面...</p>
                <div class="loading-spinner"></div>
            </div>
        </div>
    </div>

    <script src="/assets/js/main.js"></script>
    <script>
        // 全选/取消全选
        function toggleSelectAll() {
            const selectAllTop = document.getElementById('selectAll');
            const selectAllBottom = document.getElementById('selectAllBottom');
            const checkboxes = document.querySelectorAll('.product-checkbox');
            
            const isChecked = selectAllTop.checked && selectAllBottom.checked;
            
            selectAllTop.checked = isChecked;
            selectAllBottom.checked = isChecked;
            
            checkboxes.forEach(cb => cb.checked = isChecked);
            
            updateSummary();
        }
        
        // 更新统计信息
        function updateSummary() {
            const checkboxes = document.querySelectorAll('.product-checkbox:checked');
            const rows = document.querySelectorAll('tbody tr');
            
            let selectedCount = 0;
            let totalPrice = 0;
            
            checkboxes.forEach(cb => {
                const productId = cb.value;
                const row = document.querySelector(`tr[data-product-id="${productId}"]`);
                if (row) {
                    const priceCell = row.querySelector('.price');
                    const price = parseFloat(priceCell.textContent.replace('¥', '').replace(',', ''));
                    totalPrice += price;
                    selectedCount++;
                }
            });
            
            document.getElementById('selectedCount').textContent = selectedCount;
            document.getElementById('totalAmount').textContent = '¥' + totalPrice.toFixed(2);
            
            // 同步全选框状态
            const allCheckboxes = document.querySelectorAll('.product-checkbox');
            const selectAllTop = document.getElementById('selectAll');
            const selectAllBottom = document.getElementById('selectAllBottom');
            
            if (selectedCount === allCheckboxes.length) {
                selectAllTop.checked = true;
                selectAllBottom.checked = true;
            } else {
                selectAllTop.checked = false;
                selectAllBottom.checked = false;
            }
        }
        
        // 移除单个商品
        function removeItem(productId) {
            if (!confirm('确定要移除该商品吗？')) {
                return;
            }
            
            fetch('/api/cart/remove', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `product_id=${productId}`
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.message || '移除失败');
                }
            })
            .catch(err => {
                console.error('Error:', err);
                alert('网络错误，请稍后再试');
            });
        }
        
        // 清空购物车
        function clearCart() {
            if (!confirm('确定要清空购物车吗？')) {
                return;
            }
            
            fetch('/api/cart/clear', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                }
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.message || '清空失败');
                }
            })
            .catch(err => {
                console.error('Error:', err);
                alert('网络错误，请稍后再试');
            });
        }
        
        // 合并结算
        function checkout() {
            const checkboxes = document.querySelectorAll('.product-checkbox:checked');
            
            if (checkboxes.length === 0) {
                alert('请至少选择一件商品');
                return;
            }
            
            const productIds = Array.from(checkboxes).map(cb => cb.value);
            
            // 显示加载模态框
            document.getElementById('paymentModal').style.display = 'flex';
            
            fetch('/api/checkout/cart', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `product_ids[]=${productIds.join('&product_ids[]=')}`
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    // 跳转到支付宝支付页面
                    window.location.href = data.pay_url;
                } else {
                    closeModal();
                    alert(data.message || '结算失败');
                }
            })
            .catch(err => {
                closeModal();
                console.error('Error:', err);
                alert('网络错误，请稍后再试');
            });
        }
        
        // 关闭模态框
        function closeModal() {
            document.getElementById('paymentModal').style.display = 'none';
        }
        
        // 点击模态框背景关闭
        document.getElementById('paymentModal')?.addEventListener('click', function(e) {
            if (e.target === this) {
                closeModal();
            }
        });
    </script>
    
