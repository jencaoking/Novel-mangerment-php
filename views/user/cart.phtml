        .status-success { color: #28a745; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 0.5rem; animation: successPulse 0.5s ease-out; }
        .status-error { color: #dc3545; }
        
        /* 支付提示 */
        .pay-tips { padding: var(--spacing-md); background: var(--gray-50); border-radius: var(--radius-sm); }
        .pay-tips small { display: flex; align-items: center; gap: 0.3rem; }
        
        /* 动画 */
        @keyframes modalSlideIn {
            from { opacity: 0; transform: translateY(-20px) scale(0.95); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
        @keyframes successPulse {
            0% { transform: scale(0.8); opacity: 0; }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); opacity: 1; }
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        
        .spinner-border { width: 2rem; height: 2rem; border-width: 0.25em; border-style: solid; border-radius: 50%; border-right-color: transparent; animation: spin 0.75s linear infinite; }
        
        .btn-sm { padding: 0.5rem 1rem; font-size: 0.9rem; }
        .btn-lg { padding: 1rem 2rem; font-size: 1.1rem; }
        .btn-xl { padding: 1.2rem 2.5rem; font-size: 1.2rem; font-weight: 600; }
        
        @media (max-width: 768px) { 
            .user-layout { grid-template-columns: 1fr; } 
            .cart-summary { flex-direction: column; gap: var(--spacing-lg); }
            .summary-left { flex-wrap: wrap; }
        }
    </style>
</body>
</html>
