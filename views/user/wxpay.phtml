<script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.3/build/qrcode.min.js"></script>
<script>
let payTimer = null;
const codeUrl = <?php echo json_encode($codeUrl ?? ''); ?>;
const orderNo = <?php echo json_encode($order['order_no'] ?? ''); ?>;

document.addEventListener('DOMContentLoaded', function() {
    generateQrcode();
});

function generateQrcode() {
    const qrcodeContainer = document.getElementById('wxpayQrcode');
    const qrcodeLoading = document.getElementById('wxpayQrcodeLoading');

    qrcodeLoading.classList.remove('hidden');
    qrcodeContainer.innerHTML = '';

    if (!codeUrl) {
        qrcodeLoading.innerHTML = '<p class="text-danger">支付信息已过期</p>';
        return;
    }

    const canvas = document.createElement('canvas');
    QRCode.toCanvas(canvas, codeUrl, {
        width: 250,
        margin: 2,
        color: {
            dark: '#000000',
            light: '#ffffff'
        }
    }, function(error) {
        qrcodeLoading.classList.add('hidden');
        if (error) {
            console.error(error);
            qrcodeContainer.innerHTML = '<p class="text-danger">二维码生成失败</p>';
            return;
        }
        canvas.style.width = '100%';
        canvas.style.height = '100%';
        qrcodeContainer.appendChild(canvas);

        // 启动轮询
        startPaymentPolling();
    });
}

function refreshQrcode() {
    stopPaymentPolling();
    generateQrcode();
}

function startPaymentPolling() {
    stopPaymentPolling();

    payTimer = setInterval(async () => {
        try {
            const response = await fetch(`/api/order/status?batch_trade_no=${encodeURIComponent(orderNo)}`);
            const data = await response.json();

            if (data.success) {
                const statusEl = document.getElementById('wxpayStatus');
                
                if (data.status === 'paid') {
                    stopPaymentPolling();
                    showPaymentSuccess();
                } else if (data.status === 'partial_paid') {
                    statusEl.innerHTML = '<div class="status-waiting"><i class="bi bi-clock-history"></i><span>部分订单已支付，请稍候...</span></div>';
                }
            }
        } catch (err) {
            console.error('支付状态查询失败:', err);
        }
    }, 3000);
}

function stopPaymentPolling() {
    if (payTimer) {
        clearInterval(payTimer);
        payTimer = null;
    }
}

function showPaymentSuccess() {
    const statusEl = document.getElementById('wxpayStatus');
    statusEl.innerHTML = '<div class="status-success"><i class="bi bi-check-circle-fill"></i><span>支付成功！正在跳转...</span></div>';

    setTimeout(() => {
        window.location.href = '/user/downloads';
    }, 1500);
}

window.addEventListener('beforeunload', function() {
    stopPaymentPolling();
});
</script>

